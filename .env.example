# --- Option A: any OpenAI-compatible provider (e.g. DeepSeek) ---
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-...
AI_MODEL=deepseek-flash
AI_API_FORMAT=responses        # responses | chat

# --- Option B: Anthropic Claude (leave AI_PROVIDER unset or set it to anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# SOP_MODEL=claude-opus-5-5

# Optional
SOP_EFFORT=low                 # reasoning effort for chat latency
SOP_TODAY=2026-03-05           # demo date matching the sample data; remove to use the real date

# --- Hosting (set these when deployed) ---
# DEV_PASSWORD=change-me        # protects the developer view (/dev, /api/session, /api/chat); user is "dev"
# PUBLIC_BASE_URL=https://your-app.example.com   # used in consent links sent by SMS
# RATE_LIMIT_PER_MIN=30         # customer chat messages per minute per IP
# SESSION_TTL_HOURS=24          # stored conversations older than this are purged at startup
# SOP_DB_PATH=data/sop.db       # SQLite: conversations, lockout counters, consent requests
# LOCKOUT_MAX_FAILURES=5        # failed verifications per policyholder across all chats ...
# LOCKOUT_WINDOW_MIN=30         # ... within this window -> verification locked

# --- Real integrations (each falls back to the demo version when unset) ---
# Email summaries via SMTP (otherwise written to outbox/)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=claims-bot@example.com
# SMTP_PASSWORD=...
# SMTP_FROM=Claims Support <claims-bot@example.com>
# Consent by SMS link the policyholder approves/declines (otherwise fixture scenarios)
# CONSENT_MODE=link
# CONSENT_TIMEOUT_MIN=10
# TWILIO_ACCOUNT_SID=AC...      # without Twilio, the SMS is written to outbox/sms-*.json
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15550000000
# Claims/policy system REST API (otherwise fixtures/*.json)
# CLAIMS_API_URL=https://claims.internal.example.com/v1
# CLAIMS_API_TOKEN=...
# CLAIMS_API_TTL=60
